{
  "manifest_version": 3,
  "name": "Ankh Do: To-Do List & Task Timer",
  "version": "1.3.1",
  "description": "A simple to-do list and task timer for your toolbar. Add tasks, check them off, track time, and drag to reorder.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "action": {
    "default_title": "Ankh Do",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ankhdo-16.png",
      "32": "icons/ankhdo-32.png",
      "48": "icons/ankhdo-48.png",
      "128": "icons/ankhdo-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/ankhdo-16.png",
    "32": "icons/ankhdo-32.png",
    "48": "icons/ankhdo-48.png",
    "128": "icons/ankhdo-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ankh-do@thesant0x.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
